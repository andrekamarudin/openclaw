# Vikunja compose variables — copy to /opt/vikunja/.env and fill in values.
POSTGRES_USER=vikunja
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vikunja
VIKUNJA_DATABASE_HOST=db
VIKUNJA_DATABASE_TYPE=postgres
