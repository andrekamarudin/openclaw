VIKUNJA_DATABASE_PASSWORD=CHANGE_ME
VIKUNJA_DATABASE_DATABASE=vikunja
VIKUNJA_SERVICE_JWTSECRET=CHANGE_ME_RANDOM_STRING
VIKUNJA_SERVICE_FRONTENDURL=https://tasks.bytesizeprotip.com/
