# Karakeep compose variables — copy to /opt/karakeep/.env and fill in values.
# In production, secrets are fetched from Infisical (contabo-karakeep project).
KARAKEEP_VERSION=release
NEXTAUTH_SECRET=CHANGE_ME
MEILI_MASTER_KEY=CHANGE_ME
NEXTAUTH_URL=https://karakeep.bytesizeprotip.com
# AI inference (OpenAI-compatible)
# OPENAI_API_KEY=CHANGE_ME
INFERENCE_TEXT_MODEL=gpt-5.4-nano
INFERENCE_IMAGE_MODEL=gpt-5.4-nano
INFERENCE_ENABLE_AUTO_TAGGING=true
INFERENCE_ENABLE_AUTO_SUMMARIZATION=true
