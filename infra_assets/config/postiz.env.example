# Postiz configuration — copy to /opt/config/postiz.env and fill in values.
# Reference: https://docs.postiz.com/configuration/reference

# === Required ===
MAIN_URL=https://postiz.bytesizeprotip.com
FRONTEND_URL=https://postiz.bytesizeprotip.com
NEXT_PUBLIC_BACKEND_URL=https://postiz.bytesizeprotip.com/api
BACKEND_INTERNAL_URL=http://localhost:3000
JWT_SECRET=CHANGE_ME_RANDOM_STRING

# Database (must match docker-compose.postiz.yml env vars)
DATABASE_URL=postgresql://postiz:CHANGE_ME@postiz-db:5432/postiz

# Redis
REDIS_URL=redis://postiz-redis:6379

# Temporal
TEMPORAL_ADDRESS=temporal:7233

# General flags
IS_GENERAL=true
DISABLE_REGISTRATION=false
RUN_CRON=true

# === Storage ===
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# === Social Media API Keys (fill as needed) ===
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# === Optional ===
# OPENAI_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
API_LIMIT=30
NX_ADD_PLUGINS=false
